{
  "$schema": "https://opencodeai/config.json",
  "mcp": {
    "mui-mcp": {
      "type": "local",
      "command": ["bun", "x", "-y", "@mui/mcp@latest"],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": ["bun", "x", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["bun", "x", "-y", "@playwright/mcp@0.0.38"],
      "enabled": true
    },
    "storybook": {
      "type": "remote",
      "url": "http://localhost:6066/mcp",
      "enabled": true
    }
  }
}
