# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies & Package Managers
node_modules
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js, Build & Output Directories
/.next/
/.next-dev/
/.next-test/
/.next-test-*
/.next-locale-snapshots-version
/out/
/dist/
/build/
!/scripts/build/
/vercel.json
.vercel

# Testing & Storybook
/coverage/
.playwright-cli/
.playwright-mcp/
storybook-static/
*storybook.log
.graphql-test-ports
.graphql-test-heartbeats/
**/unRefactored_tests/
scripts/run-test/feedback/feedback*.md

# TypeScript, Linters & Caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.eslintcache-type-aware
eslint-results.json
.oxlint/
.oxlint-baseline.json
.scannerwork/
.quality-gate-state.json
.quality-gate-lock/
.unused/

# Reports & Duplication Scans
/report/
jscpd-admin
jscpd-intra
jscpd-output
jscpd-all

# Environment & Secrets (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.ci
*.pem
.mcp.json
.browser-auth/

# Debug, Logs & Process Artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs/
*.log
*.sql_ignore
nohup.out

# IDE & OS Metadata
.DS_Store
.idea/*
!.idea/kottaby.iml
!.idea/modules.xml

# Local Storage & Database Runtime Artifacts (not backend/db or backend/storage)
/storage/
/db/
db/app.sqlite
db/pglite/
db/pglite-test/

